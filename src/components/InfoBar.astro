---
import siteData from '../data/site.json';
import Icon from './Icon.astro';

const phoneHref = `tel:${siteData.phone.replace(/[^0-9+]/g, '')}`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(siteData.address.full)}`;
const bookingUrl = 'https://book.squareup.com/appointments/dfgljw70mpc8dx/location/9PV6DKFGH39H7/services';
---

<nav class="info-bar" aria-label="Quick contact information">
  <div class="info-bar__content">
    <a
      href={siteData.atBarbershopUrl}
      class="info-bar__item info-bar__item--established"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Visit ${siteData.atBarbershop} website (opens in new tab)`}
    >
      <span class="info-bar__label" aria-hidden="true">at</span>
      <span class="info-bar__value">{siteData.atBarbershop}</span>
    </a>

    <a
      href={phoneHref}
      class="info-bar__item info-bar__item--phone"
      aria-label={`Call us at ${siteData.phone}`}
    >
      <Icon name="phone" class="info-bar__icon" />
      <span class="info-bar__value info-bar__value--desktop">{siteData.phone}</span>
      <span class="info-bar__value info-bar__value--mobile" aria-hidden="true">Call</span>
    </a>

    <a
      href={mapsUrl}
      class="info-bar__item info-bar__item--address"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Get directions to ${siteData.address.short} (opens in new tab)`}
    >
      <Icon name="map-pin" class="info-bar__icon" />
      <span class="info-bar__value info-bar__value--desktop">{siteData.address.short}</span>
      <span class="info-bar__value info-bar__value--mobile" aria-hidden="true">Directions</span>
    </a>

    <a
      href={bookingUrl}
      class="info-bar__item info-bar__item--book"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Book an appointment with ${siteData.name} (opens in new tab)`}
    >
      <Icon name="calendar" class="info-bar__icon" />
      <span class="info-bar__value">Book Now</span>
    </a>
  </div>
</nav>

<style>
  .info-bar {
    position: relative;
    z-index: 1;
    background-color: var(--color-bg-mid);
    border-block: 1px solid rgba(201, 162, 39, 0.15);
  }

  .info-bar__content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    padding: var(--space-4);
    max-width: var(--container-max);
    margin-inline: auto;
    flex-wrap: wrap;
  }

  .info-bar__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  a.info-bar__item:hover {
    color: var(--color-primary);
  }

  a.info-bar__item:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .info-bar__label {
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
  }

  .info-bar__item :global(.info-bar__icon) {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .info-bar__value {
    font-weight: 600;
  }

  .info-bar__value--mobile,
  .info-bar__item--book {
    display: none;
  }

  @media (max-width: 640px) {
    /* Fixed bottom action bar on phones */
    .info-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: var(--z-sticky);
      background-color: rgba(26, 26, 24, 0.92);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      border-bottom: none;
      border-top: 1px solid rgba(201, 162, 39, 0.2);
      padding-bottom: env(safe-area-inset-bottom);
    }

    .info-bar__content {
      flex-wrap: nowrap;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
    }

    .info-bar__item {
      flex: 1;
      flex-direction: column;
      justify-content: center;
      gap: 2px;
      padding: var(--space-2) var(--space-1);
      border-radius: var(--radius-lg);
      font-size: var(--text-xs);
    }

    .info-bar__item :global(.info-bar__icon) {
      width: 20px;
      height: 20px;
    }

    .info-bar__item--established,
    .info-bar__value--desktop {
      display: none;
    }

    .info-bar__value--mobile {
      display: inline;
    }

    .info-bar__item--book {
      display: flex;
      flex: 1.4;
      flex-direction: row;
      gap: var(--space-2);
      color: var(--color-text-dark);
      background-color: var(--color-primary);
      font-size: var(--text-sm);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    a.info-bar__item--book:hover {
      color: var(--color-text-dark);
      background-color: var(--color-primary-dim);
    }

    .info-bar__item--book :global(.info-bar__icon) {
      color: var(--color-text-dark);
    }

    /* Room for the fixed bottom bar */
    :global(body) {
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
  }
</style>
