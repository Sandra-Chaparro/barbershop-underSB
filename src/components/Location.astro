---
import siteData from '../data/site.json';

const { coordinates, address, transit } = siteData;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address.full)}`;

// OpenStreetMap embed centered on the shop; the marker is drawn by our own overlay pin
const osmEmbedUrl = `https://www.openstreetmap.org/export/embed.html?bbox=${coordinates.lng - 0.005}%2C${coordinates.lat - 0.003}%2C${coordinates.lng + 0.005}%2C${coordinates.lat + 0.003}&layer=mapnik`;
---

<section class="location section section--alt" aria-labelledby="location-title" id="location">
  <div class="container">
    <h2 id="location-title" class="section__title">Find Us</h2>
    
    <div class="location__content">
      <div class="location__info">
        <div class="location__address">
          <h3 class="location__label">Address</h3>
          <p class="location__text">
            {address.full}
            <br />
            <span class="location__cross-streets">({address.crossStreets})</span>
          </p>
          <a 
            href={mapsUrl}
            class="btn btn--outline location__directions"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Get directions on Google Maps (opens in new tab)"
          >
            Get Directions →
          </a>
        </div>
        
      </div>
      
      <div class="location__map-wrapper">
        <iframe
          class="location__map"
          title={`Map showing the location of ${siteData.name}`}
          src={osmEmbedUrl}
          loading="lazy"
          referrerpolicy="no-referrer"
          tabindex="-1"
          aria-hidden="true"
        ></iframe>

        <div class="location__map-shade" aria-hidden="true"></div>

        <div class="location__pin" aria-hidden="true">
          <span class="location__pin-pulse"></span>
          <svg class="location__pin-icon" viewBox="0 0 24 32" width="36" height="48">
            <path d="M12 0C5.4 0 0 5.3 0 11.9 0 20.8 12 32 12 32s12-11.2 12-20.1C24 5.3 18.6 0 12 0z" />
            <circle cx="12" cy="12" r="4.5" />
          </svg>
        </div>

        <a
          href={mapsUrl}
          class="location__map-overlay"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Open ${siteData.name} location in Google Maps (opens in new tab)`}
        >
          <span class="location__map-card">
            <span class="location__map-card-title">{siteData.name}</span>
            <span class="location__map-card-address">{address.short}</span>
            <span class="location__map-card-action">Open in Maps <span aria-hidden="true">↗</span></span>
          </span>
        </a>

        <a
          href="https://www.openstreetmap.org/copyright"
          class="location__map-attribution"
          target="_blank"
          rel="noopener noreferrer"
        >
          © OpenStreetMap
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .location__content {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-8);
    align-items: start;
  }
  
  .location__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  
  .location__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }
  
  .location__text {
    font-size: var(--text-lg);
    color: var(--color-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }
  
  .location__cross-streets {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }
  
  .location__directions {
    display: inline-flex;
    margin-top: var(--space-2);
  }
  
  .location__transit-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  
  .location__transit-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  
  .location__transit-line {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 50px;
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-primary);
    color: var(--color-text-dark);
    font-size: var(--text-sm);
    font-weight: 700;
    border-radius: var(--radius-sm);
    text-align: center;
  }
  
  .location__transit-station {
    color: var(--color-text);
    font-size: var(--text-sm);
  }
  
  .location__map-wrapper {
    position: relative;
    height: 400px;
    background-color: var(--color-bg-deep);
    border: 1px solid rgba(201, 162, 39, 0.25);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-medium);
    isolation: isolate;
  }

  /* Oversized + cropped so the embed's own zoom controls and attribution bar
     sit outside the visible area (attribution is re-added below). The map
     stays centered on the shop, so the overlay pin lines up. */
  .location__map {
    position: absolute;
    top: -60px;
    left: -60px;
    width: calc(100% + 120px);
    height: calc(100% + 120px);
    border: none;
    pointer-events: none;
    /* Dark, warm-toned map to match the site palette */
    filter: invert(1) hue-rotate(180deg) brightness(0.95) contrast(0.85) saturate(0.35) sepia(0.3);
    transform: scale(1);
    transition: transform var(--transition-slow);
  }

  .location__map-wrapper:hover .location__map {
    transform: scale(1.04);
  }

  .location__map-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 50%, transparent 30%, rgba(26, 26, 24, 0.55) 100%),
      linear-gradient(to top, rgba(26, 26, 24, 0.85) 0%, transparent 45%);
  }

  .location__pin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 36px;
    height: 48px;
    transform: translate(-50%, -100%);
    pointer-events: none;
    z-index: 1;
  }

  .location__pin-icon {
    position: relative;
    display: block;
    filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.6));
    transition: transform var(--transition-normal);
    transform-origin: bottom center;
  }

  .location__pin-icon path {
    fill: var(--color-primary);
  }

  .location__pin-icon circle {
    fill: var(--color-bg-deep);
  }

  .location__map-wrapper:hover .location__pin-icon {
    transform: translateY(-4px);
  }

  .location__pin-pulse {
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 50%;
    background: rgba(201, 162, 39, 0.6);
    animation: location-pulse 2s ease-out infinite;
  }

  @keyframes location-pulse {
    0% { transform: scale(0.6); opacity: 0.9; }
    100% { transform: scale(4); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .location__pin-pulse { animation: none; opacity: 0.4; }
    .location__map,
    .location__pin-icon { transition: none; }
  }

  /* Whole map is one link to Google Maps */
  .location__map-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    padding: var(--space-4);
    text-decoration: none;
    border-radius: inherit;
  }

  .location__map-overlay:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -4px;
  }

  .location__map-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 320px;
    padding: var(--space-3) var(--space-4);
    background: rgba(26, 26, 24, 0.75);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(201, 162, 39, 0.3);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }

  .location__map-card-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-secondary);
  }

  .location__map-card-address {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .location__map-card-action {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
  }

  .location__map-card-action span {
    display: inline-block;
    transition: transform var(--transition-normal);
  }

  .location__map-overlay:hover .location__map-card-action span {
    transform: translate(2px, -2px);
  }

  .location__map-attribution {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    z-index: 3;
    padding: 2px var(--space-2);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    background: rgba(26, 26, 24, 0.6);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .location__map-attribution:hover {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .location__content {
      grid-template-columns: 1fr;
    }
    
    .location__map-wrapper {
      order: -1;
    }
    
    .location__map-wrapper {
      height: 300px;
    }

    .location__map-card {
      max-width: none;
      width: 100%;
      text-align: left;
    }
    
    .location__info {
      text-align: center;
    }
    
    .location__transit-list {
      align-items: center;
    }
    
    .location__directions {
      width: 100%;
      justify-content: center;
    }
  }
</style>

