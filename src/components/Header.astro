---
import siteData from '../data/site.json';
import Icon from './Icon.astro';

const bookingUrl = 'https://book.squareup.com/appointments/dfgljw70mpc8dx/location/9PV6DKFGH39H7/services';
---

<header class="header" id="top">
  <img
    class="header__bg"
    src="/images/hero-barber-Allen-TX.jpg"
    srcset="/images/hero-barber-Allen-TX-sm.jpg 1000w, /images/hero-barber-Allen-TX.jpg 2000w"
    sizes="100vw"
    alt=""
    fetchpriority="high"
    decoding="async"
  />
  <div class="header__overlay" aria-hidden="true"></div>

  <div class="header__content">
    <p class="header__eyebrow">Allen, Texas · Barber</p>
    <h1 class="header__title">{siteData.name}</h1>
    <p class="header__established">
      at <a href={siteData.atBarbershopUrl} target="_blank" rel="noopener noreferrer">{siteData.atBarbershop}</a>
    </p>
    <p class="header__lede">Clean fades, sharp line-ups and beard work, done with care.</p>

    <div class="header__actions">
      <a
        href={bookingUrl}
        class="btn header__cta"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Book an appointment with ${siteData.name} (opens in new tab)`}
      >
        <Icon name="calendar" size="1.15em" />
        Book Appointment
      </a>
      <a href="/#services" class="header__secondary">
        View services <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: relative;
    isolation: isolate;
    min-height: min(88vh, 820px);
    /* Slide up under the transparent navbar */
    margin-top: -60px;
    padding: calc(60px + var(--space-16)) var(--space-4) var(--space-16);
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--color-bg-deep);
  }

  .header__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% 30%;
    z-index: -2;
    animation: header-zoom 18s ease-out both;
  }

  @keyframes header-zoom {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }

  .header__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(26, 26, 24, 0.95) 0%, rgba(26, 26, 24, 0.8) 35%, rgba(26, 26, 24, 0.2) 70%, rgba(26, 26, 24, 0.35) 100%),
      linear-gradient(to top, var(--color-bg-deep) 0%, transparent 25%);
  }

  .header__content {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .header__content > * {
    max-width: 560px;
  }

  .header__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .header__eyebrow::before {
    content: '';
    width: 32px;
    height: 1px;
    background: var(--color-primary);
  }

  .header__title {
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--color-secondary);
    margin-bottom: var(--space-3);
  }

  .header__established {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .header__established a {
    color: var(--color-primary);
  }

  .header__established a:hover {
    color: var(--color-secondary);
  }

  .header__lede {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: var(--space-8);
  }

  .header__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }

  .header__cta {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-base);
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(201, 162, 39, 0.25);
    transition: background-color var(--transition-normal), color var(--transition-normal),
      transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .header__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(201, 162, 39, 0.35);
  }

  .header__secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary);
    border-bottom: 1px solid rgba(245, 240, 230, 0.3);
    padding-bottom: 2px;
  }

  .header__secondary:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .header__secondary :global(.icon) {
    transition: transform var(--transition-normal);
  }

  .header__secondary:hover :global(.icon) {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .header__bg { animation: none; }
  }

  @media (max-width: 768px) {
    .header {
      min-height: 85svh;
      align-items: flex-end;
      padding-bottom: var(--space-12);
    }

    .header__bg {
      object-position: 62% 20%;
    }

    .header__overlay {
      background:
        /* Top: keeps the navbar readable over the photo */
        linear-gradient(to bottom, rgba(26, 26, 24, 0.92) 0%, rgba(26, 26, 24, 0.55) 14%, transparent 32%),
        /* Left: same direction as the desktop hero */
        linear-gradient(90deg, rgba(26, 26, 24, 0.85) 0%, rgba(26, 26, 24, 0.4) 55%, rgba(26, 26, 24, 0.15) 100%),
        /* Bottom: behind the title and buttons */
        linear-gradient(to top, rgba(26, 26, 24, 0.98) 0%, rgba(26, 26, 24, 0.85) 38%, transparent 68%);
    }

    .header__established {
      font-size: var(--text-lg);
    }

    .header__lede {
      font-size: var(--text-base);
      margin-bottom: var(--space-6);
    }

    .header__cta {
      width: 100%;
    }

    .header__secondary {
      margin-inline: auto;
    }
  }
</style>
