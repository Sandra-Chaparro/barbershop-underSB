---
import siteData from '../data/site.json';
import Icon from './Icon.astro';

/**
 * Each service may optionally include in site.json:
 *   "price": "$35"         -> shown on the right
 *   "duration": "45 min"   -> shown under the name
 *   "description": "..."   -> shown under the name
 *   "badge": "featured" | "seasonal"
 */
interface ServicesItem {
  name: string;
  price?: string | null;
  duration?: string | null;
  description?: string | null;
  badge?: 'featured' | 'seasonal' | null;
}

interface MenuCategory {
  category: string;
  items: ServicesItem[];
}

const servicesCategories = siteData.menu as MenuCategory[];
const bookingUrl = 'https://book.squareup.com/appointments/dfgljw70mpc8dx/location/9PV6DKFGH39H7/services';
---

<section class="menu section section--alt" aria-labelledby="menu-title" id="services">
  <div class="container">
    <h2 id="menu-title" class="section__title">Services</h2>

    <div class="menu__categories">
      {servicesCategories.map((category, index) => (
        <article class="menu__category">
          <header class="menu__category-header">
            <span class="menu__category-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="menu__category-title">{category.category}</h3>
          </header>

          <ul class="menu__items" role="list">
            {category.items.map((item) => (
              <li class="menu__item">
                <div class="menu__item-main">
                  <span class="menu__item-name">
                    {item.name}
                    {item.badge && (
                      <span class={`badge badge--${item.badge}`}>
                        {item.badge === 'featured' ? 'Featured' : 'Seasonal'}
                      </span>
                    )}
                  </span>
                  {(item.duration || item.description) && (
                    <span class="menu__item-meta">
                      {[item.duration, item.description].filter(Boolean).join(' · ')}
                    </span>
                  )}
                </div>
                {item.price && <span class="menu__item-price">{item.price}</span>}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="menu__cta">
      <a
        href={bookingUrl}
        class="btn menu__cta-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="See all services and book online (opens in new tab)"
      >
        <Icon name="calendar" size="1.1em" />
        See all services &amp; book
      </a>
    </div>
  </div>
</section>

<style>
  .menu__categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .menu__category {
    position: relative;
    padding: var(--space-8) var(--space-6) var(--space-6);
    background: linear-gradient(180deg, rgba(201, 162, 39, 0.06) 0%, transparent 40%), var(--color-bg-deep);
    border: 1px solid rgba(201, 162, 39, 0.15);
    border-radius: var(--radius-lg);
    transition: transform var(--transition-normal), border-color var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .menu__category:hover {
    transform: translateY(-4px);
    border-color: rgba(201, 162, 39, 0.4);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }

  .menu__category-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-2);
    border-bottom: 1px solid rgba(201, 162, 39, 0.2);
  }

  .menu__category-number {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-primary);
  }

  .menu__category-title {
    font-size: var(--text-2xl);
    color: var(--color-secondary);
    margin: 0;
  }

  .menu__items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .menu__item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px dashed rgba(232, 228, 220, 0.1);
  }

  .menu__item:last-child {
    border-bottom: none;
  }

  .menu__item-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .menu__item-name {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-weight: 600;
    color: var(--color-text);
  }

  .menu__item-meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .menu__item-price {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .menu__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  .menu__cta-btn {
    padding: var(--space-4) var(--space-8);
    border-radius: 999px;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu__category,
    .menu__category:hover {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .menu__category {
      padding: var(--space-6) var(--space-5) var(--space-4);
    }

    .menu__category-title {
      font-size: var(--text-xl);
    }
  }
</style>
